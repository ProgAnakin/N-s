# Supabase — Project Settings → API
#
# Both values are safe to expose in the browser. The anon key is public by
# design: it ships inside the bundle of every Supabase app and grants only
# what Row Level Security allows, and every table in this app is behind RLS.
#
# Hosting dashboards sometimes flag browser-exposed variables whose name ends
# in KEY, which is why this one is just VITE_SUPABASE_ANON. That exact name is
# the only one read — a variable spelled any other way is silently ignored.
#
# Never put the service_role key here. That one is a real secret and must
# never reach the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON=your-anon-public-key
