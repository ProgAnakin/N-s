# Supabase — Project Settings → API
#
# One variable. The project URL is committed in src/data/client.ts: it is a
# public hostname, this app points at one project, and making it configuration
# only doubled the number of ways setup could silently fail.
#
# The anon key is public by design too — it ships inside the bundle of every
# Supabase app and grants only what Row Level Security allows — but it stays
# here rather than in the repository, since a committed key in a public repo
# invites drive-by sign-ups.
#
# Never put the service_role key in a VITE_ variable. That one is a real
# secret: it ignores Row Level Security entirely.
VITE_SUPABASE_ANON=your-anon-public-key

# Optional. Only needed to point a fork at a different Supabase project.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
